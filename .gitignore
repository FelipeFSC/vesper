# Arquivos de áudio: cada um coloca os seus na pasta Sons (as subpastas ficam no repositório)
Sons/**/*
!Sons/**/
!Sons/**/.gitkeep
*.mp3
*.mp4
*.ogg
*.oga
*.opus
*.m4a
*.aac
*.wav
*.flac
*.webm

# Arquivos temporários de teste
_test.html
_test.js

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Saídas dos testes
.claude/testes/*_out.html
.claude/testes/*.png
.claude/testes/edgeprof_*/

# Imagens do bestiário: cada um usa as suas (Plano 24); só a pasta vai para o repositório
imagens/bestiario/**
!imagens/bestiario/.gitkeep

